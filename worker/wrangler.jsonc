{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reading-business-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
